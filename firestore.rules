rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "duncanlloydmouendouessone@gmail.com");
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && 
        request.resource.data.role == resource.data.role; // Cannot change role
      allow delete: if isAdmin();
    }

    // Streams
    match /streams/{streamId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && 
        (request.resource.data.streamerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Donations
    match /donations/{donationId} {
      allow read: if isAuthenticated() && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toStreamerId == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated() && 
        request.resource.data.fromUserId == request.auth.uid;
    }
  }
}
